{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corregir",
  "version": "0.1.0",
  "identifier": "com.corregir.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corregir — Asistente de corrección (Fase A, datos sintéticos)",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/bin/pdfium.dll": "pdfium/bin/pdfium.dll",
      "resources/models/ocr/text-detection.rten": "models/ocr/text-detection.rten",
      "resources/models/ocr/text-recognition.rten": "models/ocr/text-recognition.rten"
    }
  }
}
